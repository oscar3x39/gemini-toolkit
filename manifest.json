{
  "manifest_version": 3,
  "name": "Gemini Toolkit",
  "version": "0.2.0",
  "description": "Gemini 側欄增強工具集:多選批次刪除、關鍵字過濾、閱讀模式(寬欄/字級/字體)。純本地執行、零外連。",
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
